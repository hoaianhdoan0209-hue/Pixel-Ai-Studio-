# Node 24 required. Set these in your shell before starting the server.
PORT=3001
HOST=127.0.0.1
DATA_DIR=./var
BOOTSTRAP_ADMIN=false
COOKIE_SECURE=false
# PUBLIC_ORIGIN=https://your-domain.example
# Production reverse proxy must preserve Host and enforce HTTPS.
# Development mail writes private messages to DATA_DIR/mail-outbox only when
# MAIL_MODE=file is explicitly enabled outside production. Never expose that folder.
MAIL_MODE=disabled
REQUIRE_VERIFIED_EMAIL=true
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_CA_FILE=/absolute/path/to/trusted-private-ca.pem
# SMTP_FROM=verified-sender@your-domain.example
# SMTP_USER and SMTP_PASS are entered securely in environment settings.
# AI_API_KEY: OpenAI credential, sent only to api.openai.com.
# ANTHROPIC_API_KEY: Anthropic credential, sent only to api.anthropic.com.
# GH_APP_ID / GH_APP_PRIVATE_KEY / GH_WEBHOOK_SECRET / APP_ENCRYPTION_KEY:
# Configure a GitHub App and a private encryption key securely; no defaults.
BUILD_RUNNER_ENABLED=false
NODE_USE_ENV_PROXY=1
# For isolated dev API port changes, set API_TARGET for the Vite proxy.
