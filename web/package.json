{
  "name": "pixel-ai-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "node scripts/test.mjs",
    "check": "tsc --noEmit",
    "backup": "node scripts/backup.mjs",
    "e2e": "python3 scripts/e2e.py"
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "parse5": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
